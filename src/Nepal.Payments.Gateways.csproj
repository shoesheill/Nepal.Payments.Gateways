<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>Nepal.Payments.Gateways</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>Sushil Shrestha</Authors>
    <Description>Easy-peasy payments gateways package for Nepal 🇳🇵 — integrate eSewa, Khalti, and Fonepay (Dynamic QR) without jhanjhat. Just plug, pay, and chill! 💸</Description>
    <PackageTags>nepal; payment; gateway; esewa; khalti; nepali; fonepay; fonepay dynamic qr; nepal payments gateways;</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>
      - Simplified integration for popular Nepali payment providers
        • eSewa
        • Khalti
        • Fonepay (Dynamic QR support)
      - Easy-to-use APIs for faster payment gateway implementation
      - 2.0.1: Fix Fonepay HMAC-SHA512 signing — dataValidation was base64-encoded,
        but Fonepay's API requires lowercase hex, so every signed request (QR
        generation, status check, tax refund) was being rejected with
        "Data Validation Failed". eSewa's HMAC-SHA256 signing is unaffected.
      - 2.1.0: eSewa V2 production form URL no longer doubles its path; Khalti V2 uses the
        documented hosts (khalti.com/api/v2/, dev.khalti.com/api/v2/) and a JSON lookup body;
        eSewa V2 callback signatures are actually verified; new PaymentManager.CheckStatusAsync
        (eSewa status API, Khalti lookup) and an optional base-URL override. System.Text.Json
        8.0.0 → 8.0.6 (netstandard targets) for GHSA-8g4q-xg66-9fp4 and GHSA-hh2w-p6rv-4g7w.
</PackageReleaseNotes>
    <PackageId>Nepal.Payments.Gateways</PackageId>
    <Version>2.1.0</Version>
    <PackageProjectUrl>https://payments-demo.nepalidev.com.np</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shoesheill/Nepal.Payments.Gateways</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2025</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nepal.Payments.Gateways.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)/../README.md" Pack="true" PackagePath="\"/>
        <!-- or if README is in the same directory as the project file -->
        <!-- <None Include="README.md" Pack="true" PackagePath="\" /> -->
    </ItemGroup>

</Project>
